{
  "name": "@mubdi/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Mubdi Social - AI Design Studio",
  "author": "Mubdi",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "typecheck": "echo ok"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.mubdi.social",
    "productName": "Mubdi",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "index.html", "renderer.js", "../../packages/*/dist/**"],
    "win": { "target": "dir" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}